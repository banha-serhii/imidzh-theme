# Shared-hosting deploy — copy to `.env` and fill in.
# NEVER commit `.env` or real passwords/keys.

# sftp (recommended) | ftps
DEPLOY_PROTOCOL=sftp

DEPLOY_HOST=example.com
# sftp default 22, ftps default 21 — omit to use the protocol default
DEPLOY_PORT=22
DEPLOY_USER=

# Password auth (leave empty when using a private key)
DEPLOY_PASSWORD=

# Absolute or ~-relative path to an OpenSSH private key (SFTP)
DEPLOY_PRIVATE_KEY=
# Optional passphrase for that key
DEPLOY_PRIVATE_KEY_PASSPHRASE=

# Remote theme directory on the host (created if missing)
# Example: /home/USER/public_html/wp-content/themes/imidzh-theme
DEPLOY_REMOTE_PATH=

# FTPS only: set to false if the host uses a self-signed TLS certificate
# DEPLOY_TLS_REJECT_UNAUTHORIZED=true
