{
  "name": "imidzh-theme",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "description": "WordPress theme for Ліцей Імідж — local build and shared-hosting deploy",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "bump": "node scripts/bump.js",
    "deploy": "node scripts/deploy.js",
    "zip": "node scripts/zip.js",
    "release:patch": "node scripts/bump.js --level patch && node scripts/build.js",
    "release:minor": "node scripts/bump.js --level minor && node scripts/build.js",
    "release:major": "node scripts/bump.js --level major && node scripts/build.js"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "basic-ftp": "^5.0.5",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.0",
    "ssh2-sftp-client": "^12.0.1"
  }
}
